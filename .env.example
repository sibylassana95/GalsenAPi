# Environnement : local | production
DJANGO_ENV=local

# Cle secrete Django (obligatoire, generer avec : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=change-me

# Mode debug (ne jamais activer en production)
DEBUG=True

# Hotes autorises (separes par des virgules)
ALLOWED_HOSTS=localhost,127.0.0.1

# Origines CORS autorisees (separees par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://galsenapi.vercel.app

# Moteur de base de donnees : sqlite | postgresql | mysql
DB_ENGINE=sqlite

# PostgreSQL (cible)
POSTGRES_DB=galsenapi
POSTGRES_USER=galsenapi
POSTGRES_PASSWORD=galsenapi
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# MySQL (transitionnel : prod cPanel actuelle, a retirer apres migration vers PostgreSQL)
MYSQL_DB=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Production uniquement
SECURE_SSL_REDIRECT=False
STATIC_ROOT=
MEDIA_ROOT=
